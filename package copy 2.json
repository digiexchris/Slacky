{
  "name": "slacky",
  "version": "0.0.6",
  "description": "Slack wrapper for Linux arm64 systems",
  "main": "dist/app/src/app.js",
  "scripts": {
    "start": "electron .",
    "build": "swc src -d dist/app",
    "dev": "nodemon --watch src --ext ts --exec \"yarn run build && yarn run start\"",
    "pack": "yarn build && USE_SYSTEM_FPM=1 electron-builder",
    "publish": "USE_SYSTEM_FPM=1 electron-builder --publish always",
    "dist:dir": "yarn dist --dir -c.compression=store -c.mac.identity=null",
    "app:dir": "yarn build && electron-builder --dir",
    "app:dirarm": "yarn build && electron-builder --dir --linux --arm64",
    "app:dist": "yarn build && DEBUG=\"@malept/flatpak-bundler\" electron-builder",
    "app:distarm": "yarn build && electron-builder --linux --arm64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andirsun/slack-arm64.git"
  },
  "author": "Anderson Laverde <hola@andersonlaverde.com>",
  "homepage": "https://github.com/andirsun/Slacky",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andirsun/slack-arm64/issues",
    "email": "hola@andersonlaverde.com"
  },
  "dependencies": {
    "source-map-support": "^0.5.16",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.3",
    "@swc/core": "^1.3.102",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "electron": "^38.5.0",
    "electron-builder": "^26.0.20",
    "eslint": "^8.56.0"
  },
  "postinstall": "electron-builder install-app-deps",
  "build": {
    "appId": "com.andersonlaverde.slacky",
    "productName": "Slacky",
    "artifactName": "Slacky-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb"
      ],
      "category": "Social",
      "icon": "icons"
    },
    "directories": {
      "buildResources": "build",
      "output": "out"
    },
    "files": [
      "dist"
    ],
    "flatpak": {
      "branch": "master",
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "useWaylandFlags": true,
      "finishArgs": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--device=dri",
        "--filesystem=xdg-download",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=com.canonical.Unity",
        "--own-name=org.kde.StatusNotifierItem-*",
        "--talk-name=com.canonical.AppMenu.Registrar",
        "--env=XCURSOR_PATH=/run/host/user-share/icons:/run/host/share/icon"
      ]
    }
  }
}
